# Naive image: full Python base, everything as root. Used only to measure the "before" size.
FROM python:3.12
ARG SERVICE
WORKDIR /app
COPY common/ ./common/
COPY ${SERVICE}/ ./
RUN pip install -r requirements.txt
ENV PYTHONPATH=/app
CMD ["gunicorn", "--preload", "--bind", "0.0.0.0:8080", "wsgi:app"]
