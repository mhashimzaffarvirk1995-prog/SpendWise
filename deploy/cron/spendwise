# SpendWise scheduled jobs (installed to /etc/cron.d/spendwise)
SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
MAILTO=""

# Nightly backup at 02:00 UTC
0 2 * * * root /usr/local/bin/spendwise-backup >> /var/log/spendwise-backup.log 2>&1

# Health check every 5 minutes
*/5 * * * * root { date -Is; /usr/local/bin/spendwise-healthcheck; } >> /var/log/spendwise-healthcheck.log 2>&1
