[Unit]
Description=SpendWise - 9 Flask microservices
After=network-online.target
Wants=network-online.target
RequiresMountsFor=/var/lib/spendwise

[Service]
Type=simple
User=spendwise
Group=spendwise
WorkingDirectory=/opt/spendwise
ExecStart=/opt/spendwise/.venv/bin/python run.py
Environment=PYTHONUNBUFFERED=1
Restart=on-failure
RestartSec=5

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/var/lib/spendwise

[Install]
WantedBy=multi-user.target
